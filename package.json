{
  "name": "captionly",
  "productName": "Captionly",
  "version": "1.0.0",
  "description": "Captionly — local auto-captions for short-form video. Whisper transcription, styled karaoke/word-highlight captions, ffmpeg burn-in to MP4, SRT/ASS export. Pay once — no Submagic subscription.",
  "main": "main.js",
  "author": "Ben (bensblueprints)",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/smoke.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bensblueprints.captionly",
    "productName": "Captionly",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "menuCategory": "OneTimeSuite"
    }
  }
}
